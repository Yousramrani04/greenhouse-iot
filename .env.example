# Copier en .env puis REMPLACER les valeurs "change_me_*". Ne jamais committer .env.

# --- MinIO (Bronze / Silver / Gold) ---
MINIO_ROOT_USER=change_me_user
MINIO_ROOT_PASSWORD=change_me_password_min8
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000   # scripts Python
S3_ENDPOINT=localhost:9000              # dbt / DuckDB (sans http://)

# --- PostgreSQL (supervision live + catalogue Iceberg) ---
POSTGRES_USER=greenhouse
POSTGRES_PASSWORD=change_me_pg_password
POSTGRES_PORT=5433
POSTGRES_DB=greenhouse
ICEBERG_CATALOG_DB=iceberg_catalog

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_UI_PORT=8085

# --- Grafana ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana
